# Copy to .env (same directory) and fill in. chmod 600.
# SUPABASE_URL: Project Settings -> API -> Project URL, e.g. https://abcdefgh.supabase.co
# Auth mode A (recommended): publishable key (Dashboard -> API keys) + BRIDGE_SECRET,
#   a random token also stored in the project's vault; RLS policies match it
#   against the x-bridge-secret request header.
# Auth mode B: SUPABASE_SERVICE_KEY=... (service_role / sb_secret) — bypasses RLS.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
BRIDGE_SECRET=
